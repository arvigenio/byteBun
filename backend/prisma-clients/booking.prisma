// ============================================================================================
// booking: the Bookings app.
// ============================================================================================

model BookingSettings {
  organizationId      String   @id @map("organization_id")
  // Public page: bookings.bytebuntech.com/{slug}
  slug                String   @unique @db.VarChar(60)
  businessName        String   @map("business_name") @db.VarChar(120)
  // IANA zone, e.g. America/Toronto.
  timeZone            String   @map("time_zone") @db.VarChar(64)
  // slots | date (no interval: customers pick a day, first come first served)
  mode                String   @default("slots") @db.VarChar(10)
  intervalMinutes     Int      @default(30) @map("interval_minutes")
  bookersPerSlot      Int      @default(1) @map("bookers_per_slot")
  // null = no limit
  maxPerDay           Int?     @map("max_per_day")
  minNoticeMinutes    Int      @default(120) @map("min_notice_minutes")
  windowDays          Int      @default(60) @map("window_days")
  // Customers can't cancel/reschedule within this many hours (null = until it starts).
  changeCutoffHours   Int?     @map("change_cutoff_hours")
  phone               String?  @db.VarChar(40)
  contactEmail        String?  @map("contact_email") @db.VarChar(254)
  // Shown on the public page.
  pageInstructions    String?  @map("page_instructions") @db.VarChar(2000)
  // Rich text (sanitized HTML) shown ONLY in confirmations and reminders.
  privateInstructions String?  @map("private_instructions") @db.VarChar(5000)
  primaryColor        String   @default("#0F766E") @map("primary_color") @db.VarChar(7)
  accentColor         String?  @map("accent_color") @db.VarChar(7)
  backgroundColor     String?  @map("background_color") @db.VarChar(7)
  // light | dark | custom
  theme               String   @default("light") @db.VarChar(10)
  font                String   @default("system") @db.VarChar(20)
  buttonStyle         String   @default("rounded") @map("button_style") @db.VarChar(10)
  // Owner alerts: {"newBooking": ["email"], "cancellation": ["email"], "reschedule": ["email"]}
  ownerAlerts         Json     @default("{}") @map("owner_alerts")
  // WhatsApp number for owner alerts (paid plans).
  alertPhone          String?  @map("alert_phone") @db.VarChar(40)
  // Reminders to customers: [{ "offsetMinutes": 1440, "channel": "email" }], at most 3.
  // Free: 1440 and/or 2880, email. Paid: down to 60 minutes, email or whatsapp.
  reminders           Json     @default("[{\"offsetMinutes\": 1440, \"channel\": \"email\"}]")
  // Email customers marked as no-show, inviting them to book again.
  noShowFollowUp      Boolean  @default(true) @map("no_show_follow_up")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
  @@schema("booking")
}

// Opening hours, one row per open weekday (0 = Sunday ... 6 = Saturday). No row = closed.
model WeeklyHours {
  id             Int    @id @default(autoincrement())
  organizationId String @map("organization_id")
  weekday        Int    @db.SmallInt
  // Minutes after local midnight, e.g. 540 = 9:00.
  startMinute    Int    @map("start_minute") @db.SmallInt
  endMinute      Int    @map("end_minute") @db.SmallInt

  @@unique([organizationId, weekday])
  @@map("weekly_hours")
  @@schema("booking")
}

// Breaks (lunch ...) inside a weekday's hours.
model BreakPeriod {
  id             Int    @id @default(autoincrement())
  organizationId String @map("organization_id")
  weekday        Int    @db.SmallInt
  startMinute    Int    @map("start_minute") @db.SmallInt
  endMinute      Int    @map("end_minute") @db.SmallInt

  @@index([organizationId])
  @@map("breaks")
  @@schema("booking")
}

// Closed days: a single date (start = end) or a range, inclusive, in the business's dates.
model BlockedDate {
  id             Int      @id @default(autoincrement())
  organizationId String   @map("organization_id")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  /// Part of a day: minutes after midnight (both set) on each date; both null = the whole day.
  startMinute    Int?     @map("start_minute")
  endMinute      Int?     @map("end_minute")
  /// One service only; null = the whole business.
  serviceId      Int?     @map("service_id")
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reason         String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, startDate])
  @@index([serviceId])
  @@map("blocked_dates")
  @@schema("booking")
}

model Service {
  id              Int       @id @default(autoincrement())
  organizationId  String    @map("organization_id")
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(1000)
  durationMinutes Int       @map("duration_minutes")
  bufferMinutes   Int       @default(0) @map("buffer_minutes")
  // in_person | online | phone
  locationType    String    @default("in_person") @map("location_type") @db.VarChar(12)
  address         String?   @db.VarChar(300)
  // Private: only in confirmations and reminders.
  meetingUrl      String?   @map("meeting_url") @db.VarChar(500)
  // Private rich text (sanitized HTML), confirmations and reminders only.
  instructions    String?   @db.VarChar(5000)
  position        Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings        Booking[]
  timeOff         BlockedDate[]

  @@index([organizationId, position])
  @@map("services")
  @@schema("booking")
}

// The people who book (patients, customers). One row per email per business.
model Customer {
  id             Int       @id @default(autoincrement())
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(120)
  email          String    @db.VarChar(254)
  phone          String?   @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  bookings       Booking[]

  @@unique([organizationId, email])
  @@map("customers")
  @@schema("booking")
}

model Booking {
  id             Int            @id @default(autoincrement())
  organizationId String         @map("organization_id")
  serviceId      Int            @map("service_id")
  service        Service        @relation(fields: [serviceId], references: [id])
  customerId     Int            @map("customer_id")
  customer       Customer       @relation(fields: [customerId], references: [id])
  // The business's date of the booking (used for daily limits and date-only bookings).
  localDate      DateTime       @map("local_date") @db.Date
  // Time slots: the appointment. Date-only: the day's opening time (for reminders and sorting).
  startsAt       DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime       @map("ends_at") @db.Timestamptz(3)
  // endsAt + the service's buffer: the time this booking keeps its slot.
  blockedUntil   DateTime       @map("blocked_until") @db.Timestamptz(3)
  dateOnly       Boolean        @default(false) @map("date_only")
  // confirmed | cancelled
  status         String         @default("confirmed") @db.VarChar(12)
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  // customer | business | system
  cancelledBy    String?        @map("cancelled_by") @db.VarChar(12)
  cancelReason   String?        @map("cancel_reason") @db.VarChar(500)
  // Marked by the business when the customer didn't come.
  noShowAt       DateTime?      @map("no_show_at") @db.Timestamptz(3)
  // Attendance: the code in the emails' QR code (8 characters, no look-alikes), and when the
  // front desk checked the customer in (and who: a user id).
  checkInCode    String         @map("check_in_code") @db.Char(8)
  checkedInAt    DateTime?      @map("checked_in_at") @db.Timestamptz(3)
  checkedInBy    String?        @map("checked_in_by")
  // Bumped on each reschedule (calendar SEQUENCE).
  sequence       Int            @default(0)
  // Behind the customer's cancel/reschedule link (src/clients/booking/manage-token.ts).
  manageNonce    String         @map("manage_nonce") @db.Char(32)
  note           String?        @db.VarChar(1000)
  // public (booking page) | business (added by the owner/staff)
  source         String         @default("public") @db.VarChar(10)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  notifications  Notification[]

  @@unique([organizationId, checkInCode])
  @@index([organizationId, localDate])
  @@index([organizationId, startsAt])
  @@index([organizationId, createdAt])
  @@map("bookings")
  @@schema("booking")
}

// Notification queue: one row per message to send. A worker sends the due rows (email here;
// WhatsApp rows are handed to n8n).
model Notification {
  id             Int       @id @default(autoincrement())
  organizationId String    @map("organization_id")
  bookingId      Int?      @map("booking_id")
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // confirmation | cancellation | reschedule | owner_new | owner_cancel | owner_reschedule | reminder | ...
  kind           String    @db.VarChar(30)
  // email | whatsapp
  channel        String    @default("email") @db.VarChar(10)
  recipient      String    @db.VarChar(254)
  sendAt         DateTime  @map("send_at") @db.Timestamptz(3)
  // pending | sending | sent | failed | cancelled | skipped | paused (business deactivated)
  status         String    @default("pending") @db.VarChar(10)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(500)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  payload        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, sendAt])
  @@index([bookingId])
  @@map("notifications")
  @@schema("booking")
}

// Events: one-time seminars, webinars, classes, on a public page (/{business}/e/{slug}).
// free: anyone registers on the page. paid: there is no payment gateway yet, so the business takes
// the payment itself, enters the attendee and gives them a code; the attendee registers with it.
// No rescheduling or cancelling by attendees; the business can revoke free registrations.
model Event {
  id             Int           @id @default(autoincrement())
  organizationId String        @map("organization_id")
  slug           String        @db.VarChar(80)
  title          String        @db.VarChar(160)
  /// Rich text (sanitized like instructions).
  description    String?       @db.VarChar(20000)
  /// free | paid
  kind           String        @default("free") @db.VarChar(8)
  /// Shown on the page for paid events, e.g. "₱1,500" (no payment is taken here).
  priceLabel     String?       @map("price_label") @db.VarChar(60)
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  /// The event's time zone (IANA, e.g. Asia/Manila); null = the business's.
  timeZone       String?       @map("time_zone") @db.VarChar(64)
  /// onsite | online
  format         String        @default("onsite") @db.VarChar(8)
  address        String?       @db.VarChar(300)
  /// Onsite, optional: floor, unit, landmarks, or a place the map search can't find.
  addressDetails String?       @map("address_details") @db.VarChar(300)
  /// Onsite: the exact map pin (both or neither).
  latitude       Float?
  longitude      Float?
  /// Online: may come later; attendees are emailed when it is added or changed.
  meetingUrl     String?       @map("meeting_url") @db.VarChar(500)
  /// Places (confirmed registrations and unused paid codes); null = no limit.
  capacity       Int?
  /// Set by Byte Bun when a bigger event is bought (free plan: 50 included; 51-300 $10, up to
  /// 500 $20, more: custom). Null = the plan's limit (limit:events.participants).
  participantLimit Int?    @map("participant_limit")
  /// Open for registration (and the page is public).
  published      Boolean       @default(false)
  /// The registration button's text (default: "Register for free" / "Confirm my place").
  registerLabel  String?       @map("register_label") @db.VarChar(40)
  /// Deleting the event: SHA-256 of the 6-digit code emailed to the person asking, until when,
  /// who asked, and wrong tries so far (5 at most).
  deleteCodeHash      String?   @map("delete_code_hash") @db.Char(64)
  deleteCodeExpiresAt DateTime? @map("delete_code_expires_at") @db.Timestamptz(3)
  deleteCodeUserId    String?   @map("delete_code_user_id")
  deleteCodeAttempts  Int       @default(0) @map("delete_code_attempts")
  /// Events without a voucher (50 participants or fewer) are deleted 3 months after they end:
  /// when the business agreed to that, and which reminders (days before: 7, 3, 1) were sent.
  retentionAgreedAt   DateTime? @map("retention_agreed_at") @db.Timestamptz(3)
  retentionNotices    Int[]     @default([]) @map("retention_notices")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tickets        EventTicket[]
  scanners       EventScanner[]
  claimables     EventClaimable[]
  vouchers       EventVoucher[]

  @@unique([organizationId, slug])
  @@index([organizationId, startsAt])
  @@map("events")
  @@schema("booking")
}

// One registration. Its code (8 characters, no look-alikes) is the paid event's "ticket" and the
// attendance code in the QR code; codes are unique per business across bookings and events.
model EventTicket {
  id             Int       @id @default(autoincrement())
  eventId        Int       @map("event_id")
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(120)
  email          String    @db.VarChar(254)
  phone          String?   @db.VarChar(40)
  code           String    @db.Char(8)
  /// pending (paid: code given, not used yet) | confirmed | revoked (by the business) | cancelled (by the attendee, free events)
  status         String    @default("confirmed") @db.VarChar(10)
  /// Behind the attendee's private cancel link (free events): /{business}/e/{event}#cancel={id}.{nonce}
  manageNonce    String    @default(dbgenerated("md5((random())::text || (clock_timestamp())::text)")) @map("manage_nonce") @db.Char(32)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// public (registered on the page) | business (code issued by the business)
  source         String    @default("public") @db.VarChar(10)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?   @map("revoke_reason") @db.VarChar(500)
  checkedInAt    DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedInBy    String?   @map("checked_in_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  claims         EventClaim[]

  @@unique([organizationId, code])
  @@index([eventId, status])
  @@map("event_tickets")
  @@schema("booking")
}

// A bigger event, paid for by hand: Byte Bun creates a voucher on the admin site (8 characters,
// for one business) and gives it to the client, who enters it when making (or growing) an
// event. It sets that event's participant limit; it works once.
model EventVoucher {
  id             Int       @id @default(autoincrement())
  organizationId String    @map("organization_id")
  code           String    @unique @db.Char(8)
  /// The most participants the event may then have (e.g. 300 for $10, 500 for $20, or custom).
  participants   Int
  priceLabel     String?   @map("price_label") @db.VarChar(60)
  note           String?   @db.VarChar(500)
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  /// The event it was used on; cleared if that event is deleted (the voucher stays as a record).
  eventId        Int?      @map("event_id")
  event          Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([eventId])
  @@map("event_vouchers")
  @@schema("booking")
}

// An attendance scanner for one free event: a person (first and last name, role "Attendance"),
// a scanner code (in the link scanner host /{business}/{event}/{scannerCode}) and an access code.
// The first device to sign in with both gets a session; nobody else can. Revoking the access
// code (codeHash null), making a new one, or deleting the scanner signs that device out.
// limit:events.scanners: 2 per event on every plan.
model EventScanner {
  id             Int       @id @default(autoincrement())
  eventId        Int       @map("event_id")
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String    @map("organization_id")
  publicId       String    @unique @map("public_id") @db.Uuid
  /// The scanner's ID, in its link and typed on the scanner site (8 characters, unique).
  scannerCode    String    @unique @map("scanner_code") @db.Char(8)
  firstName      String    @default("") @map("first_name") @db.VarChar(60)
  lastName       String    @default("") @map("last_name") @db.VarChar(60)
  role           String    @default("Attendance") @db.VarChar(40)
  /// Where the scanner code and access code are emailed.
  email          String    @default("") @db.VarChar(254)
  /// Set: this scanner scans claims for that item (e.g. Free Water); null: attendance.
  claimableId    Int?      @map("claimable_id")
  claimable      EventClaimable? @relation(fields: [claimableId], references: [id], onDelete: Cascade)
  /// Old name field (before first/last name); unused.
  label          String?   @db.VarChar(60)
  /// SHA-256 of the access code (unique); null = revoked (a new one must be made).
  codeHash       String?   @unique @map("code_hash") @db.Char(64)
  /// The access code encrypted (AES-256-GCM, iv.tag.data base64url), shown to the business.
  accessCodeEnc  String?   @map("access_code_enc") @db.VarChar(120)
  codeCreatedAt  DateTime? @map("code_created_at") @db.Timestamptz(3)
  /// When a device entered the code (then the code can't be used again).
  redeemedAt     DateTime? @map("redeemed_at") @db.Timestamptz(3)
  /// SHA-256 of that device's session token.
  sessionHash    String?   @map("session_hash") @db.Char(64)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  claims         EventClaim[]

  @@index([eventId])
  @@map("event_scanners")
  @@schema("booking")
}

// Something attendees can claim at a free event (e.g. "Free Water", "Snack"), with its own
// scanners. Limit per event: limit:events.claimables.
model EventClaimable {
  id             Int            @id @default(autoincrement())
  eventId        Int            @map("event_id")
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String         @map("organization_id")
  name           String         @db.VarChar(60)
  position       Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  scanners       EventScanner[]
  claims         EventClaim[]

  @@index([eventId])
  @@map("event_claimables")
  @@schema("booking")
}

// One attendee claimed one item (once each).
model EventClaim {
  id             Int            @id @default(autoincrement())
  claimableId    Int            @map("claimable_id")
  claimable      EventClaimable @relation(fields: [claimableId], references: [id], onDelete: Cascade)
  ticketId       Int            @map("ticket_id")
  ticket         EventTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String         @map("organization_id")
  /// Cleared if the scanner is deleted (claimedBy keeps the name).
  scannerId      Int?           @map("scanner_id")
  scanner        EventScanner?  @relation(fields: [scannerId], references: [id], onDelete: SetNull)
  /// "Mara Santos (Free Water)" or the staff member's name.
  claimedBy      String?        @map("claimed_by") @db.VarChar(200)
  claimedAt      DateTime       @default(now()) @map("claimed_at") @db.Timestamptz(3)

  @@unique([claimableId, ticketId])
  @@index([ticketId])
  @@index([scannerId])
  @@map("event_claims")
  @@schema("booking")
}
