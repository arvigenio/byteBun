// ============================================================================================
// booking: the Bookings app.
// ============================================================================================

model BookingSettings {
  organizationId      String   @id @map("organization_id")
  // Public page: bookings.bytebuntech.com/{slug}
  slug                String   @unique @db.VarChar(60)
  businessName        String   @map("business_name") @db.VarChar(120)
  // IANA zone, e.g. America/Toronto.
  timeZone            String   @map("time_zone") @db.VarChar(64)
  /// The business's currency (ISO 4217): the default wherever a currency is chosen (event prices,
  /// refunds). Its time zone above is the default for time zones.
  currency            String   @default("PHP") @db.Char(3)
  // slots | date (no interval: customers pick a day, first come first served)
  mode                String   @default("slots") @db.VarChar(10)
  intervalMinutes     Int      @default(30) @map("interval_minutes")
  bookersPerSlot      Int      @default(1) @map("bookers_per_slot")
  // null = no limit
  maxPerDay           Int?     @map("max_per_day")
  minNoticeMinutes    Int      @default(120) @map("min_notice_minutes")
  windowDays          Int      @default(60) @map("window_days")
  // Customers can't cancel/reschedule within this many hours (null = until it starts).
  changeCutoffHours   Int?     @map("change_cutoff_hours")
  phone               String?  @db.VarChar(40)
  contactEmail        String?  @map("contact_email") @db.VarChar(254)
  // Shown on the public page.
  pageInstructions    String?  @map("page_instructions") @db.VarChar(2000)
  // Rich text (sanitized HTML) shown ONLY in confirmations and reminders.
  privateInstructions String?  @map("private_instructions") @db.VarChar(5000)
  primaryColor        String   @default("#0F766E") @map("primary_color") @db.VarChar(7)
  accentColor         String?  @map("accent_color") @db.VarChar(7)
  backgroundColor     String?  @map("background_color") @db.VarChar(7)
  // light | dark | custom
  theme               String   @default("light") @db.VarChar(10)
  font                String   @default("system") @db.VarChar(20)
  buttonStyle         String   @default("rounded") @map("button_style") @db.VarChar(10)
  // Owner alerts: {"newBooking": ["email"], "cancellation": ["email"], "reschedule": ["email"]}
  ownerAlerts         Json     @default("{}") @map("owner_alerts")
  // WhatsApp number for owner alerts (paid plans).
  alertPhone          String?  @map("alert_phone") @db.VarChar(40)
  // Reminders to customers: [{ "offsetMinutes": 1440, "channel": "email" }], at most 3.
  // Free: 1440 and/or 2880, email. Paid: down to 60 minutes, email or whatsapp.
  reminders           Json     @default("[{\"offsetMinutes\": 1440, \"channel\": \"email\"}]")
  // Email customers marked as no-show, inviting them to book again.
  noShowFollowUp      Boolean  @default(true) @map("no_show_follow_up")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
  @@schema("booking")
}

// Opening hours, one row per open weekday (0 = Sunday ... 6 = Saturday). No row = closed.
model WeeklyHours {
  id             Int    @id @default(autoincrement())
  organizationId String @map("organization_id")
  weekday        Int    @db.SmallInt
  // Minutes after local midnight, e.g. 540 = 9:00.
  startMinute    Int    @map("start_minute") @db.SmallInt
  endMinute      Int    @map("end_minute") @db.SmallInt

  @@unique([organizationId, weekday])
  @@map("weekly_hours")
  @@schema("booking")
}

// Breaks (lunch ...) inside a weekday's hours.
model BreakPeriod {
  id             Int    @id @default(autoincrement())
  organizationId String @map("organization_id")
  weekday        Int    @db.SmallInt
  startMinute    Int    @map("start_minute") @db.SmallInt
  endMinute      Int    @map("end_minute") @db.SmallInt

  @@index([organizationId])
  @@map("breaks")
  @@schema("booking")
}

// Closed days: a single date (start = end) or a range, inclusive, in the business's dates.
model BlockedDate {
  id             Int      @id @default(autoincrement())
  organizationId String   @map("organization_id")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  /// Part of a day: minutes after midnight (both set) on each date; both null = the whole day.
  startMinute    Int?     @map("start_minute")
  endMinute      Int?     @map("end_minute")
  /// One service only; null = the whole business.
  serviceId      Int?     @map("service_id")
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reason         String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, startDate])
  @@index([serviceId])
  @@map("blocked_dates")
  @@schema("booking")
}

model Service {
  id              Int       @id @default(autoincrement())
  organizationId  String    @map("organization_id")
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(1000)
  durationMinutes Int       @map("duration_minutes")
  bufferMinutes   Int       @default(0) @map("buffer_minutes")
  // in_person | online | phone
  locationType    String    @default("in_person") @map("location_type") @db.VarChar(12)
  address         String?   @db.VarChar(300)
  // Private: only in confirmations and reminders.
  meetingUrl      String?   @map("meeting_url") @db.VarChar(500)
  // Private rich text (sanitized HTML), confirmations and reminders only.
  instructions    String?   @db.VarChar(5000)
  position        Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings        Booking[]
  timeOff         BlockedDate[]

  @@index([organizationId, position])
  @@map("services")
  @@schema("booking")
}

// The people who book (patients, customers). One row per email per business.
model Customer {
  id             Int       @id @default(autoincrement())
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(120)
  email          String    @db.VarChar(254)
  phone          String?   @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  bookings       Booking[]

  @@unique([organizationId, email])
  @@map("customers")
  @@schema("booking")
}

model Booking {
  id             Int            @id @default(autoincrement())
  organizationId String         @map("organization_id")
  serviceId      Int            @map("service_id")
  service        Service        @relation(fields: [serviceId], references: [id])
  customerId     Int            @map("customer_id")
  customer       Customer       @relation(fields: [customerId], references: [id])
  // The business's date of the booking (used for daily limits and date-only bookings).
  localDate      DateTime       @map("local_date") @db.Date
  // Time slots: the appointment. Date-only: the day's opening time (for reminders and sorting).
  startsAt       DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime       @map("ends_at") @db.Timestamptz(3)
  // endsAt + the service's buffer: the time this booking keeps its slot.
  blockedUntil   DateTime       @map("blocked_until") @db.Timestamptz(3)
  dateOnly       Boolean        @default(false) @map("date_only")
  // confirmed | cancelled
  status         String         @default("confirmed") @db.VarChar(12)
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  // customer | business | system
  cancelledBy    String?        @map("cancelled_by") @db.VarChar(12)
  cancelReason   String?        @map("cancel_reason") @db.VarChar(500)
  // Marked by the business when the customer didn't come.
  noShowAt       DateTime?      @map("no_show_at") @db.Timestamptz(3)
  // Attendance: the code in the emails' QR code (8 characters, no look-alikes), and when the
  // front desk checked the customer in (and who: a user id).
  checkInCode    String         @map("check_in_code") @db.Char(8)
  checkedInAt    DateTime?      @map("checked_in_at") @db.Timestamptz(3)
  checkedInBy    String?        @map("checked_in_by")
  // Bumped on each reschedule (calendar SEQUENCE).
  sequence       Int            @default(0)
  // Behind the customer's cancel/reschedule link (src/clients/booking/manage-token.ts).
  manageNonce    String         @map("manage_nonce") @db.Char(32)
  note           String?        @db.VarChar(1000)
  // public (booking page) | business (added by the owner/staff)
  source         String         @default("public") @db.VarChar(10)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  notifications  Notification[]

  @@unique([organizationId, checkInCode])
  @@index([organizationId, localDate])
  @@index([organizationId, startsAt])
  @@index([organizationId, createdAt])
  @@map("bookings")
  @@schema("booking")
}

// Notification queue: one row per message to send. A worker sends the due rows (email here;
// WhatsApp rows are handed to n8n).
model Notification {
  id             Int       @id @default(autoincrement())
  organizationId String    @map("organization_id")
  bookingId      Int?      @map("booking_id")
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // confirmation | cancellation | reschedule | owner_new | owner_cancel | owner_reschedule | reminder | ...
  kind           String    @db.VarChar(30)
  // email | whatsapp
  channel        String    @default("email") @db.VarChar(10)
  recipient      String    @db.VarChar(254)
  sendAt         DateTime  @map("send_at") @db.Timestamptz(3)
  // pending | sending | sent | failed | cancelled | skipped | paused (business deactivated)
  status         String    @default("pending") @db.VarChar(10)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(500)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  payload        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, sendAt])
  @@index([bookingId])
  @@map("notifications")
  @@schema("booking")
}

// Events: one-time seminars, webinars, classes, on a public page (/{business}/e/{slug}).
// free: anyone registers on the page. paid: there is no payment gateway yet, so the business takes
// the payment itself, enters the attendee and gives them a code; the attendee registers with it.
// No rescheduling or cancelling by attendees; the business can revoke free registrations.
model Event {
  id             Int           @id @default(autoincrement())
  organizationId String        @map("organization_id")
  slug           String        @db.VarChar(80)
  title          String        @db.VarChar(160)
  /// Rich text (sanitized like instructions).
  description    String?       @db.VarChar(20000)
  /// free | paid
  kind           String        @default("free") @db.VarChar(8)
  /// Paid events: the price (required), in `currency` (ISO 4217, e.g. PHP). priceLabel is it
  /// formatted for the page and emails, e.g. "₱1,500" (no payment is taken here).
  /// The event page's cover photo and logo (images in UPLOADS_DIR/event-media/, public).
  coverFile      String?       @map("cover_file") @db.VarChar(80)
  coverType      String?       @map("cover_type") @db.VarChar(40)
  logoFile       String?       @map("logo_file") @db.VarChar(80)
  logoType       String?       @map("logo_type") @db.VarChar(40)
  price          Decimal?      @db.Decimal(12, 2)
  currency       String?       @db.Char(3)
  priceLabel     String?       @map("price_label") @db.VarChar(60)
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  /// The event's time zone (IANA, e.g. Asia/Manila); null = the business's.
  timeZone       String?       @map("time_zone") @db.VarChar(64)
  /// onsite | online
  format         String        @default("onsite") @db.VarChar(8)
  address        String?       @db.VarChar(300)
  /// Onsite, optional: floor, unit, landmarks, or a place the map search can't find.
  addressDetails String?       @map("address_details") @db.VarChar(300)
  /// Onsite: the exact map pin (both or neither).
  latitude       Float?
  longitude      Float?
  /// Online: may come later; attendees are emailed when it is added or changed.
  meetingUrl     String?       @map("meeting_url") @db.VarChar(500)
  /// Places (confirmed registrations and unused paid codes); null = no limit.
  capacity       Int?
  /// Set by Byte Bun when a bigger event is bought (free plan: 50 included; 51-300 $10, up to
  /// 500 $20, more: custom). Null = the plan's limit (limit:events.participants).
  participantLimit Int?    @map("participant_limit")
  /// Open for registration (and the page is public).
  published      Boolean       @default(false)
  /// The registration button's text (default: "Register for free" / "Register").
  registerLabel  String?       @map("register_label") @db.VarChar(40)
  /// Deleting the event: SHA-256 of the 6-digit code emailed to the person asking, until when,
  /// who asked, and wrong tries so far (5 at most).
  deleteCodeHash      String?   @map("delete_code_hash") @db.Char(64)
  deleteCodeExpiresAt DateTime? @map("delete_code_expires_at") @db.Timestamptz(3)
  deleteCodeUserId    String?   @map("delete_code_user_id")
  deleteCodeAttempts  Int       @default(0) @map("delete_code_attempts")
  /// Events without a voucher (50 participants or fewer) are deleted 3 months after they end:
  /// when the business agreed to that, and which reminders (days before: 7, 3, 1) were sent.
  retentionAgreedAt   DateTime? @map("retention_agreed_at") @db.Timestamptz(3)
  retentionNotices    Int[]     @default([]) @map("retention_notices")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tickets        EventTicket[]
  scanners       EventScanner[]
  claimables     EventClaimable[]
  vouchers       EventVoucher[]
  paymentChannels EventPaymentChannel[]
  promoCodes     EventPromoCode[]
  affiliates     EventAffiliate[]
  team           EventMember[]
  chatRoom       ChatRoom?

  @@unique([organizationId, slug])
  @@index([organizationId, startsAt])
  @@map("events")
  @@schema("booking")
}

// One registration. Its code (8 characters, no look-alikes) is the paid event's "ticket" and the
// attendance code in the QR code; codes are unique per business across bookings and events.
model EventTicket {
  id             Int       @id @default(autoincrement())
  eventId        Int       @map("event_id")
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(120)
  email          String    @db.VarChar(254)
  phone          String?   @db.VarChar(40)
  /// The check-in code. Paid registrations get one only once the payment is confirmed.
  code           String?   @db.Char(8)
  /// pending (paid: code given, not used yet) | reserved (paid: spots held 2 hours for the proof, reuploadBy)
  /// | waitlist (paid, full: offered a freed spot in order) | review (paid: proof of payment uploaded, to verify)
  /// | rejected (paid: proof not accepted; re-upload by reuploadBy or the place is freed)
  /// | confirmed | revoked (by the business) | cancelled (by the attendee, free events)
  status         String    @default("confirmed") @db.VarChar(10)
  /// Behind the attendee's private cancel link (free events): /{business}/e/{event}#cancel={id}.{nonce}
  manageNonce    String    @default(dbgenerated("md5((random())::text || (clock_timestamp())::text)")) @map("manage_nonce") @db.Char(32)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// public (registered on the page) | payment (with a proof of payment) | business (code issued
  /// by the business) | manual (registered by the business, paid to them directly or free)
  source         String    @default("public") @db.VarChar(10)
  /// Paid events, once confirmed: what they paid (the Collections tab). proof | code | manual | free
  paymentMethod  String?   @map("payment_method") @db.VarChar(10)
  amountPaid     Decimal?  @map("amount_paid") @db.Decimal(12, 2)
  paidCurrency   String?   @map("paid_currency") @db.Char(3)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(3)
  /// The promo code used for this place (snapshot) and its discount, in the event's currency.
  promoCodeId    Int?      @map("promo_code_id")
  promo          EventPromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCode      String?   @map("promo_code") @db.VarChar(30)
  discount       Decimal?  @db.Decimal(12, 2)
  /// Bulk bookings: the places booked together (one name and email, one proof of payment, verified
  /// together) share a group id; groupSize is how many.
  groupId        String?   @map("group_id") @db.VarChar(36)
  groupSize      Int?      @map("group_size")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?   @map("revoke_reason") @db.VarChar(500)
  checkedInAt    DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedInBy    String?   @map("checked_in_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Why a new proof is asked for (emailed to the attendee).
  paymentNote       String?   @map("payment_note") @db.VarChar(500)
  /// Status "rejected" (waiting for a proof): replace (another proof instead of the last one) |
  /// additional (an extra proof, e.g. the rest of an insufficient amount: amountDue).
  proofRequest      String?   @map("proof_request") @db.VarChar(12)
  amountDue         String?   @map("amount_due") @db.VarChar(60)
  /// The current upload link's secret (SHA-256): a new one for every request, cleared once used.
  uploadTokenHash   String?   @map("upload_token_hash") @db.Char(64)
  /// Waiting for a proof: the attendee may upload until then; after it, the place is freed.
  reuploadBy        DateTime? @map("reupload_by") @db.Timestamptz(3)
  paymentReviewedAt DateTime? @map("payment_reviewed_at") @db.Timestamptz(3)
  paymentReviewedBy String?   @map("payment_reviewed_by") @db.VarChar(200)
  claims         EventClaim[]
  proofs         EventPaymentProof[]
  refunds        EventRefund[]
  logs           EventTicketLog[]
  refundRequests EventRefundRequest[]

  @@unique([organizationId, code])
  @@index([eventId, status])
  @@index([groupId])
  @@map("event_tickets")
  @@schema("booking")
}

// A bigger event, paid for by hand: Byte Bun creates a voucher on the admin site (8 characters,
// for one business) and gives it to the client, who enters it when making (or growing) an
// event. It sets that event's participant limit; it works once.
model EventVoucher {
  id             Int       @id @default(autoincrement())
  organizationId String    @map("organization_id")
  code           String    @unique @db.Char(8)
  /// The most participants the event may then have (e.g. 300 for $10, 500 for $20, or custom).
  participants   Int
  priceLabel     String?   @map("price_label") @db.VarChar(60)
  note           String?   @db.VarChar(500)
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  /// The event it was used on; cleared if that event is deleted (the voucher stays as a record).
  eventId        Int?      @map("event_id")
  event          Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([eventId])
  @@map("event_vouchers")
  @@schema("booking")
}

// An attendance scanner for one free event: a person (first and last name, role "Attendance"),
// a scanner code (in the link scanner host /{business}/{event}/{scannerCode}) and an access code.
// The first device to sign in with both gets a session; nobody else can. Revoking the access
// code (codeHash null), making a new one, or deleting the scanner signs that device out.
// limit:events.scanners: 2 per event on every plan.
model EventScanner {
  id             Int       @id @default(autoincrement())
  eventId        Int       @map("event_id")
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String    @map("organization_id")
  publicId       String    @unique @map("public_id") @db.Uuid
  /// The scanner's ID, in its link and typed on the scanner site (8 characters, unique).
  scannerCode    String    @unique @map("scanner_code") @db.Char(8)
  firstName      String    @default("") @map("first_name") @db.VarChar(60)
  lastName       String    @default("") @map("last_name") @db.VarChar(60)
  role           String    @default("Attendance") @db.VarChar(40)
  /// Where the scanner code and access code are emailed.
  email          String    @default("") @db.VarChar(254)
  /// Set: this scanner scans claims for that item (e.g. Free Water); null: attendance.
  claimableId    Int?      @map("claimable_id")
  claimable      EventClaimable? @relation(fields: [claimableId], references: [id], onDelete: Cascade)
  /// Old name field (before first/last name); unused.
  label          String?   @db.VarChar(60)
  /// SHA-256 of the access code (unique); null = revoked (a new one must be made).
  codeHash       String?   @unique @map("code_hash") @db.Char(64)
  /// The access code encrypted (AES-256-GCM, iv.tag.data base64url), shown to the business.
  accessCodeEnc  String?   @map("access_code_enc") @db.VarChar(120)
  codeCreatedAt  DateTime? @map("code_created_at") @db.Timestamptz(3)
  /// When a device entered the code (then the code can't be used again).
  redeemedAt     DateTime? @map("redeemed_at") @db.Timestamptz(3)
  /// SHA-256 of that device's session token.
  sessionHash    String?   @map("session_hash") @db.Char(64)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  claims         EventClaim[]

  @@index([eventId])
  @@map("event_scanners")
  @@schema("booking")
}

// Something attendees can claim at a free event (e.g. "Free Water", "Snack"), with its own
// scanners. Limit per event: limit:events.claimables.
model EventClaimable {
  id             Int            @id @default(autoincrement())
  eventId        Int            @map("event_id")
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String         @map("organization_id")
  name           String         @db.VarChar(60)
  position       Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  scanners       EventScanner[]
  claims         EventClaim[]

  @@index([eventId])
  @@map("event_claimables")
  @@schema("booking")
}

// One attendee claimed one item (once each).
model EventClaim {
  id             Int            @id @default(autoincrement())
  claimableId    Int            @map("claimable_id")
  claimable      EventClaimable @relation(fields: [claimableId], references: [id], onDelete: Cascade)
  ticketId       Int            @map("ticket_id")
  ticket         EventTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String         @map("organization_id")
  /// Cleared if the scanner is deleted (claimedBy keeps the name).
  scannerId      Int?           @map("scanner_id")
  scanner        EventScanner?  @relation(fields: [scannerId], references: [id], onDelete: SetNull)
  /// "Mara Santos (Free Water)" or the staff member's name.
  claimedBy      String?        @map("claimed_by") @db.VarChar(200)
  claimedAt      DateTime       @default(now()) @map("claimed_at") @db.Timestamptz(3)

  @@unique([claimableId, ticketId])
  @@index([ticketId])
  @@index([scannerId])
  @@map("event_claims")
  @@schema("booking")
}

// How attendees pay for a paid event (up to 4, shown on the registration form): a QR code image
// (in UPLOADS_DIR/event-payment-qr/) or bank details.
model EventPaymentChannel {
  id             Int      @id @default(autoincrement())
  eventId        Int      @map("event_id")
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String   @map("organization_id")
  position       Int      @default(0)
  /// qr | bank
  type           String   @db.VarChar(10)
  /// e.g. "GCash", "Maya", "BDO savings"
  label          String   @db.VarChar(60)
  bankName       String?  @map("bank_name") @db.VarChar(100)
  accountName    String?  @map("account_name") @db.VarChar(120)
  accountNumber  String?  @map("account_number") @db.VarChar(60)
  qrFile         String?  @map("qr_file") @db.VarChar(80)
  qrType         String?  @map("qr_type") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([eventId])
  @@map("event_payment_channels")
  @@schema("booking")
}

// A proof of payment (image or PDF) in UPLOADS_DIR/event-proofs/. A registration may have several
// (an additional proof for an insufficient amount, or replaced ones). Every file is kept, with its
// outcome, until the event is deleted (by the business, or automatically: then the files are
// emailed in the event's zip first).
model EventPaymentProof {
  id             Int         @id @default(autoincrement())
  ticketId       Int         @map("ticket_id")
  ticket         EventTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  file           String      @db.VarChar(80)
  name           String      @db.VarChar(200)
  type           String      @db.VarChar(40)
  size           Int
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// What became of it (null = current, being verified): replaced | approved | rejected |
  /// refunded | expired | removed. The file is kept until the event is deleted.
  outcomeAt      DateTime?   @map("outcome_at") @db.Timestamptz(3)
  outcome        String?     @db.VarChar(20)

  @@index([ticketId])
  @@map("event_payment_proofs")
  @@schema("booking")
}

// A refund the business made (by hand) and told the attendee about. The proof of refund is
// emailed to the attendee and kept (proofFile) until the event is deleted.
model EventRefund {
  id             Int         @id @default(autoincrement())
  ticketId       Int         @map("ticket_id")
  ticket         EventTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  /// full | partial (an excess amount paid back)
  type           String      @db.VarChar(10)
  /// The amount refunded, in `currency`; `amount` is it formatted, e.g. "₱50".
  amountValue    Decimal?    @map("amount_value") @db.Decimal(12, 2)
  currency       String?     @db.Char(3)
  amount         String?     @db.VarChar(60)
  /// Full refunds: the registration was cancelled too.
  cancelled      Boolean     @default(false)
  note           String?     @db.VarChar(500)
  proofName      String?     @map("proof_name") @db.VarChar(200)
  /// The proof of refund, kept in UPLOADS_DIR/event-refund-proofs/ until the event is deleted.
  proofFile      String?     @map("proof_file") @db.VarChar(80)
  proofType      String?     @map("proof_type") @db.VarChar(40)
  createdBy      String      @map("created_by") @db.VarChar(200)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ticketId])
  @@map("event_refunds")
  @@schema("booking")
}

// A registration's activity log: every action on it, who did it and when (registered, proof
// uploaded, payment approved, proof requested, refunded, checked in, claimed, revoked...).
model EventTicketLog {
  id             Int         @id @default(autoincrement())
  ticketId       Int         @map("ticket_id")
  ticket         EventTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  action         String      @db.VarChar(30)
  /// Who: a staff member's name, a scanner, "Attendee" or "System".
  by             String?     @db.VarChar(200)
  detail         String?     @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@map("event_ticket_logs")
  @@schema("booking")
}

// A paid event's promo code: an amount or a percentage off, per place. usageLimit: how many
// places can use it (1 = one-time, null = unlimited); used counts them. Optional expiry.
model EventPromoCode {
  id             Int           @id @default(autoincrement())
  eventId        Int           @map("event_id")
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String        @map("organization_id")
  /// Upper case, e.g. EARLYBIRD
  code           String        @db.VarChar(30)
  /// amount | percent
  discountType   String        @map("discount_type") @db.VarChar(10)
  discountValue  Decimal       @map("discount_value") @db.Decimal(12, 2)
  usageLimit     Int?          @map("usage_limit")
  used           Int           @default(0)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tickets        EventTicket[]
  /// Set when this is an event affiliate's code (managed on the Affiliates tab, not Promo codes).
  affiliate      EventAffiliate?

  @@unique([eventId, code])
  @@map("event_promo_codes")
  @@schema("booking")
}

// A paid event's affiliate (up to 5 per event; the event's Affiliates tab). The business sets the
// attendee discount (their promo code: a percentage off, unlimited uses) and the commission (a %
// of what each attendee paid). A spot counts once its payment is verified (status confirmed); the
// business pays the affiliate and records it (EventAffiliatePayout).
model EventAffiliate {
  id                Int                    @id @default(autoincrement())
  eventId           Int                    @map("event_id")
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId    String                 @map("organization_id")
  affiliateId       Int                    @map("affiliate_id")
  affiliate         Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// As the business entered them (the person's own profile may differ).
  firstName         String                 @map("first_name") @db.VarChar(60)
  lastName          String                 @map("last_name") @db.VarChar(60)
  email             String                 @db.VarChar(254)
  phone             String                 @db.VarChar(40)
  promoCodeId       Int                    @unique @map("promo_code_id")
  promo             EventPromoCode         @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  commissionPercent Decimal                @map("commission_percent") @db.Decimal(5, 2)
  /// invited | active | disabled (the promo code works only while active)
  status            String                 @default("invited") @db.VarChar(20)
  /// The sign-up link {AFFILIATES_URL}/join#t=e{id}.{secret}: only the secret's hash is kept.
  inviteHash        String?                @map("invite_hash") @db.VarChar(64)
  inviteExpiresAt   DateTime?              @map("invite_expires_at") @db.Timestamptz(3)
  invitedAt         DateTime               @default(now()) @map("invited_at") @db.Timestamptz(3)
  joinedAt          DateTime?              @map("joined_at") @db.Timestamptz(3)
  createdBy         String                 @map("created_by") @db.VarChar(254)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  payouts           EventAffiliatePayout[]

  @@unique([eventId, affiliateId])
  @@index([affiliateId])
  @@map("event_affiliates")
  @@schema("booking")
}

// Money the business sent an event affiliate (their earned commission), in the event's currency.
model EventAffiliatePayout {
  id               Int            @id @default(autoincrement())
  eventAffiliateId Int            @map("event_affiliate_id")
  eventAffiliate   EventAffiliate @relation(fields: [eventAffiliateId], references: [id], onDelete: Cascade)
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @db.Char(3)
  reference        String?        @db.VarChar(120)
  createdBy        String         @map("created_by") @db.VarChar(254)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("event_affiliate_payouts")
  @@schema("booking")
}

// A refund request: the business asks the attendee where to send their money (a unique emailed
// link); they upload a QR code or enter bank details; the business pays them, then marks it
// completed with the proof of refund (emailed to them; the refund is recorded then).
model EventRefundRequest {
  id             Int         @id @default(autoincrement())
  ticketId       Int         @map("ticket_id")
  ticket         EventTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  /// full (what hasn't been refunded yet) | partial (amountValue)
  type           String      @db.VarChar(10)
  amountValue    Decimal?    @map("amount_value") @db.Decimal(12, 2)
  currency       String?     @db.Char(3)
  /// Full refunds: cancel the registration when completed.
  cancel         Boolean     @default(false)
  /// A bulk booking: the request covers every spot of the ticket's group.
  wholeBooking   Boolean     @default(false) @map("whole_booking")
  note           String?     @db.VarChar(500)
  /// waiting (link sent) | submitted (details received) | completed | cancelled
  status         String      @default("waiting") @db.VarChar(10)
  tokenHash      String?     @map("token_hash") @db.Char(64)
  /// What the attendee gave: qr (an image in UPLOADS_DIR/event-refund-details/) | bank
  method         String?     @db.VarChar(10)
  bankName       String?     @map("bank_name") @db.VarChar(100)
  accountName    String?     @map("account_name") @db.VarChar(120)
  accountNumber  String?     @map("account_number") @db.VarChar(60)
  qrFile         String?     @map("qr_file") @db.VarChar(80)
  qrType         String?     @map("qr_type") @db.VarChar(40)
  submittedAt    DateTime?   @map("submitted_at") @db.Timestamptz(3)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(3)
  completedBy    String?     @map("completed_by") @db.VarChar(200)
  refundId       Int?        @map("refund_id")
  createdBy      String      @map("created_by") @db.VarChar(200)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ticketId])
  @@map("event_refund_requests")
  @@schema("booking")
}

// ============================================================================================
// Team: custom roles, who works on which event, and the team chat (src/clients/team/).
// ============================================================================================

// A custom role (Team page): a name and permissions from src/clients/roles.ts PERMISSION_CATALOG.
// Members on it are staff (members.role) with members.team_role_id set.
model TeamRole {
  id             Int          @id @default(autoincrement())
  organizationId String       @map("organization_id")
  name           String       @db.VarChar(40)
  permissions    String[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  members        Member[]
  invitations    Invitation[]

  @@unique([organizationId, name])
  @@map("team_roles")
  @@schema("booking")
}

// A team member assigned to an event. Everyone except owners and admins sees only the events
// they're assigned to (and those events' chat rooms).
model EventMember {
  eventId        Int      @map("event_id")
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  assignedBy     String   @map("assigned_by") @db.VarChar(254)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([eventId, userId])
  @@index([organizationId, userId])
  @@map("event_members")
  @@schema("booking")
}

// A chat room: the whole team (one per business), an event's (its assigned members, owners and
// admins), or a direct conversation between two members. `key` makes each one unique:
// team:{org} | event:{eventId} | dm:{org}:{userA}:{userB} (user ids sorted).
model ChatRoom {
  id             Int           @id @default(autoincrement())
  organizationId String        @map("organization_id")
  key            String        @unique @db.VarChar(200)
  /// team | event | direct
  kind           String        @db.VarChar(10)
  eventId        Int?          @unique @map("event_id")
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userA          String?       @map("user_a")
  userB          String?       @map("user_b")
  lastMessageAt  DateTime?     @map("last_message_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  messages       ChatMessage[]
  reads          ChatRead[]

  @@index([organizationId, kind])
  @@map("chat_rooms")
  @@schema("booking")
}

// A message: text and/or one attachment (an image or PDF in UPLOADS_DIR/chat-files/, private).
model ChatMessage {
  id             Int       @id @default(autoincrement())
  roomId         Int       @map("room_id")
  room           ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  body           String    @default("") @db.VarChar(4000)
  file           String?   @db.VarChar(64)
  fileType       String?   @map("file_type") @db.VarChar(40)
  fileName       String?   @map("file_name") @db.VarChar(200)
  fileSize       Int?      @map("file_size")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Deleted by its author: the text and file are removed, the row stays as "deleted".
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([roomId, id])
  @@map("chat_messages")
  @@schema("booking")
}

// How far a member has read a room, and up to which message they were emailed about (offline).
model ChatRead {
  roomId     Int      @map("room_id")
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  lastReadId Int      @default(0) @map("last_read_id")
  notifiedId Int      @default(0) @map("notified_id")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([roomId, userId])
  @@index([userId])
  @@map("chat_reads")
  @@schema("booking")
}
