{
  "name": "bytebun-api",
  "version": "1.0.0",
  "private": true,
  "description": "Byte Bun Tech API: NestJS + TypeScript, Prisma ORM on PostgreSQL.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nodemon",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "seed:admins": "node dist/scripts/seed-admins.js",
    "admin:reset-2fa": "node dist/scripts/reset-2fa.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/platform-socket.io": "^12.4.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.18",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.4",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "typescript": "~6.0.2"
  }
}
