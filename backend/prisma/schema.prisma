// Database schema. After changing it, create a migration with:
//   docker compose exec api npm run db:migrate:new -- --name describe_change
// Review the new prisma/migrations/<timestamp>_describe_change/migration.sql. In development the
// API restarts and applies it right away, so don't rename the folder afterwards. Migrations are
// also applied on every start, in dev and production.

// prisma-client-js generates the client (with TypeScript types) into node_modules/@prisma/client.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tables and columns use snake_case so they can be queried in psql without quoting.
model Lead {
  id           Int      @id @default(autoincrement())
  firstName    String   @map("first_name") @db.VarChar(50)
  lastName     String   @map("last_name") @db.VarChar(50)
  email        String   @db.VarChar(254)
  phone        String?  @db.VarChar(40)
  businessName String?  @map("business_name") @db.VarChar(160)
  businessType String   @map("business_type") @db.VarChar(80)
  // JSON arrays of option keys, e.g. ["more-bookings","other"] (src/leads/lead-options.ts).
  goals        String?  @db.VarChar(1000)
  // The visitor's own words when "other" is one of the goals.
  goalsOther   String?  @map("goals_other") @db.VarChar(200)
  features     String?  @db.VarChar(1000)
  message      String?  @db.VarChar(2000)
  source       String   @default("website") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  status       String   @default("new") @db.VarChar(30)
  booking      Booking?

  @@index([createdAt], map: "ix_leads_created_at")
  @@index([email], map: "ix_leads_email")
  @@map("leads")
}

// The free call a lead booked on the lead page. One per lead; starts_at is unique, so a slot
// can't be booked twice (the API answers 409 if two people race for it).
// To free a slot (e.g. a cancelled call), delete its row here.
model Booking {
  id        Int      @id @default(autoincrement())
  leadId    Int      @unique @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Call start (an absolute instant). Availability rules: src/booking/availability.ts.
  startsAt  DateTime @unique @map("starts_at") @db.Timestamptz(3)
  // The visitor's time zone when they booked (IANA name, e.g. "America/New_York").
  timeZone  String?  @map("time_zone") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("bookings")
}
