// Database schema. After changing it, create a migration with:
//   docker compose exec api npm run db:migrate:new -- --name describe_change
// Review the new prisma/migrations/<timestamp>_describe_change/migration.sql. In development the
// API restarts and applies it right away, so don't rename the folder afterwards. Migrations are
// also applied on every start, in dev and production.

// prisma-client-js generates the client (with TypeScript types) into node_modules/@prisma/client.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tables and columns use snake_case so they can be queried in psql without quoting.
model Lead {
  id           Int      @id @default(autoincrement())
  firstName    String   @map("first_name") @db.VarChar(50)
  lastName     String   @map("last_name") @db.VarChar(50)
  email        String   @db.VarChar(254)
  phone        String?  @db.VarChar(40)
  businessName String?  @map("business_name") @db.VarChar(160)
  businessType String   @map("business_type") @db.VarChar(80)
  // JSON arrays of option keys, e.g. ["more-bookings","other"] (src/leads/lead-options.ts).
  goals        String?  @db.VarChar(1000)
  // The visitor's own words when "other" is one of the goals.
  goalsOther   String?  @map("goals_other") @db.VarChar(200)
  features     String?  @db.VarChar(1000)
  message      String?  @db.VarChar(2000)
  // Which button opened the form ("hero", "final-cta", ...), or "chatbot" for the chat calendar.
  source       String   @default("website") @db.VarChar(50)
  // Where the booking came from (src/leads/attribution.ts). channel: web_form | chatbot.
  channel      String   @default("web_form") @db.VarChar(20)
  // How they reached the site: social | search | ads | email | referral | direct; null for leads
  // from before this was recorded. originDetail: the platform or site ("Facebook", "Google").
  origin       String?  @db.VarChar(20)
  originDetail String?  @map("origin_detail") @db.VarChar(80)
  utmSource    String?  @map("utm_source") @db.VarChar(100)
  utmMedium    String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign  String?  @map("utm_campaign") @db.VarChar(100)
  referrerHost String?  @map("referrer_host") @db.VarChar(253)
  landingPath  String?  @map("landing_path") @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  status       String   @default("new") @db.VarChar(30)
  // Random value behind the lead's reschedule/cancel link (src/booking/manage-link.ts). The link is
  // signed with a server-only key, so this alone can't make a working link. A new value revokes old links.
  manageNonce  String?  @map("manage_nonce") @db.Char(32)
  booking      Booking?

  @@index([createdAt], map: "ix_leads_created_at")
  @@index([email], map: "ix_leads_email")
  @@map("leads")
}

// The free call a lead booked on the lead page. One per lead; starts_at is unique, so a slot
// can't be booked twice (the API answers 409 if two people race for it).
// To free a slot (e.g. a cancelled call), delete its row here.
model Booking {
  id        Int      @id @default(autoincrement())
  leadId    Int      @unique @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Call start (an absolute instant). Availability rules: src/booking/availability.ts.
  startsAt  DateTime @unique @map("starts_at") @db.Timestamptz(3)
  // The visitor's time zone when they booked (IANA name, e.g. "America/New_York").
  timeZone  String?  @map("time_zone") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // Lead emails (src/leads/lead-emails.ts): when the confirmation went out, when the reminder
  // is due (24 h before, or 2 h before for short-notice bookings) and when it went out.
  confirmationSentAt DateTime? @map("confirmation_sent_at") @db.Timestamptz(3)
  reminderAt         DateTime? @map("reminder_at") @db.Timestamptz(3)
  reminderSentAt     DateTime? @map("reminder_sent_at") @db.Timestamptz(3)
  // Bumped on every reschedule, so calendar apps update the event instead of adding a copy.
  sequence           Int       @default(0)

  @@index([reminderAt], map: "ix_bookings_reminder_at")
  @@map("bookings")
}

// ---- Prospecting (src/prospects/) ----
// Search results live in memory for 30 minutes; these are the businesses an admin chose to keep,
// optionally sorted into groups ("Makati dentists", "Follow up in January", ...).

model ProspectGroup {
  id        Int             @id @default(autoincrement())
  name      String          @unique @db.VarChar(80)
  createdBy String          @map("created_by") @db.VarChar(254)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  prospects SavedProspect[]

  @@map("prospect_groups")
}

// A snapshot of one business as the search showed it (refreshed when it's saved again, or when
// its website checkup finishes). One row per business: external_id is the source's place ID.
model SavedProspect {
  id           Int            @id @default(autoincrement())
  externalId   String         @unique @map("external_id") @db.VarChar(200)
  // Deleting a group keeps its prospects (they become ungrouped).
  groupId      Int?           @map("group_id")
  group        ProspectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name         String         @db.VarChar(200)
  category     String?        @db.VarChar(120)
  address      String?        @db.VarChar(400)
  city         String?        @db.VarChar(120)
  country      String?        @db.VarChar(120)
  latitude     Float
  longitude    Float
  phone        String?        @db.VarChar(60)
  email        String?        @db.VarChar(254)
  website      String?        @db.VarChar(500)
  mapsUrl      String?        @map("maps_url") @db.VarChar(1000)
  rating       Float?
  reviewCount  Int?           @map("review_count")
  // Chance to sign up when saved (src/prospects/scoring.ts): 0-100, hot | warm | cold.
  score        Int
  tier         String         @db.VarChar(10)
  // JSON: [{ network, url }], [{ key, label, points }], ["Custom website design", ...], checkup.
  socials      Json           @default("[]")
  reasons      Json           @default("[]")
  pitch        Json           @default("[]")
  checkup      Json?
  websiteKind  String         @map("website_kind") @db.VarChar(10)
  // The search it came from.
  industry     String         @db.VarChar(80)
  location     String         @db.VarChar(120)
  source       String         @db.VarChar(20)
  note         String?        @db.VarChar(2000)
  savedBy      String         @map("saved_by") @db.VarChar(254)
  savedAt      DateTime       @default(now()) @map("saved_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([groupId], map: "ix_saved_prospects_group_id")
  @@index([savedAt], map: "ix_saved_prospects_saved_at")
  @@map("saved_prospects")
}

// ---- Admin sign-in (Better Auth, src/auth/auth.ts) ----
// Field names are what Better Auth expects; columns are snake_case like the tables above.
// There is no sign-up: admins are created by `npm run seed:admins`. Sign-in is passwordless
// (email code + authenticator app), so no password is ever stored.

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  twoFactorEnabled Boolean?    @default(false) @map("two_factor_enabled")
  // Admin plugin fields.
  role             String?
  banned           Boolean?    @default(false)
  banReason        String?     @map("ban_reason")
  banExpires       DateTime?   @map("ban_expires") @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]

  @@map("auth_users")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?  @map("impersonated_by")
  // True only for sessions created by a successful authenticator/backup-code check
  // (set in src/auth/auth.ts). A session from the email code alone stays false and can only
  // finish the second step.
  secondFactorVerified Boolean? @default(false) @map("second_factor_verified")

  @@index([userId], map: "ix_auth_sessions_user_id")
  @@map("auth_sessions")
}

// Required by Better Auth's core. Stays empty for our admins (no passwords, no social logins).
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "ix_auth_accounts_user_id")
  @@map("auth_accounts")
}

// Email sign-in codes (hashed) and pending second-step challenges.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "ix_auth_verifications_identifier")
  @@map("auth_verifications")
}

// Authenticator secret and backup codes (both encrypted with BETTER_AUTH_SECRET).
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([secret], map: "ix_auth_two_factors_secret")
  @@index([userId], map: "ix_auth_two_factors_user_id")
  @@map("auth_two_factors")
}

// Better Auth's per-IP rate limits (rateLimit.storage = "database").
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

// Fixed-window counters for our own limits: alert throttling and codes sent per email
// (src/auth/security-counter.ts). Keys look like "alert:<event>:<email>" or "otp-send:<email>".
model SecurityCounter {
  key            String   @id @db.VarChar(400)
  windowStart    DateTime @map("window_start") @db.Timestamptz(3)
  count          Int
  // Events suppressed in the window before this one (reported with the next alert).
  prevSuppressed Int      @default(0) @map("prev_suppressed")

  @@map("security_counters")
}

// ---------------------------------------------------------------- admin task board
// The admin Tasks page (src/tasks): a kanban board of tasks; each task has its own board of subtasks.

model AdminTask {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(200)
  description String?        @db.VarChar(2000)
  // todo | in_progress | done (src/tasks/tasks.schema.ts)
  status      String         @default("todo") @db.VarChar(20)
  // Order inside its column, from 0.
  position    Int            @default(0)
  createdBy   String         @map("created_by") @db.VarChar(254)
  // The admin it is assigned to (an email from src/auth/admins.ts), or null for nobody yet.
  assignedTo  String?        @map("assigned_to") @db.VarChar(254)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  // When it was moved to Done (cleared when it leaves Done).
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(3)
  subtasks    AdminSubtask[]

  @@index([status, position], map: "ix_admin_tasks_status_position")
  @@map("admin_tasks")
}

model AdminSubtask {
  id        Int       @id @default(autoincrement())
  // Deleting a task deletes its subtasks.
  taskId    Int       @map("task_id")
  task      AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(200)
  // todo | in_progress | done: its column on the task's own board (same states as a task).
  status    String    @default("todo") @db.VarChar(20)
  // Order inside its column, from 0.
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([taskId], map: "ix_admin_subtasks_task_id")
  @@map("admin_subtasks")
}
