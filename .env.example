# Copy this file to .env and change the values. Never commit .env.
# For local development everything has a safe default, so .env is optional.

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
# Comma-separated list of origins allowed to call the API from a browser.
FRONTEND_ORIGIN=http://localhost:5173
# Production only: the public URL of the site (used for canonical links and the sitemap at build time).
SITE_URL=https://bytebuntech.com
# Production only: number of reverse proxies in front of the app (1 for Nginx, Caddy, or Traefik).
TRUST_PROXY=1
# Production only: the host port the app container publishes (bound to 127.0.0.1; your reverse proxy forwards to it).
APP_PORT=4000

# PostgreSQL. The Compose db container creates DB_USER / DB_PASSWORD / DB_NAME on its first start;
# changing them later has no effect on an existing volume (reset it with: npm run reset-db).
# Use a long random password. Avoid the $ character, Docker Compose treats it as a variable.
DB_HOST=db
DB_PORT=5432
DB_NAME=bytebun
DB_USER=bytebun
DB_PASSWORD=ChangeMe_Str0ng
# TLS to the database. Leave false for the Compose db; set true for a managed PostgreSQL host.
DB_SSL=false
# Development only: the host port the db container publishes on 127.0.0.1 (for psql / pgAdmin).
DB_HOST_PORT=5432

# Rate limit for POST /api/leads (requests per window, per IP)
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_MINUTES=15
# Testing only: true switches OFF every request limit (sign-in attempts, codes sent, lead form,
# API). The API logs a warning while it is on. Never leave it on in production.
RATE_LIMITS_DISABLED=false

# Logging: fatal, error, warn, info, debug
LOG_LEVEL=info

# Optional integrations (leave empty for now)
# When set, every saved lead is POSTed here as JSON (n8n, then GoHighLevel).
N8N_WEBHOOK_URL=

# ---- Admin sign-in (Better Auth) ----
# Passwordless: an emailed code, then an authenticator app. See README "Admin sign-in".
# Development works without any of these. Production requires them (except the webhook).

# Signs cookies and encrypts authenticator secrets. At least 32 characters:  openssl rand -base64 32
# Changing it signs everyone out AND invalidates every enrolled authenticator (both admins must
# then be reset with: npm run admin:reset-2fa -- <email>).
BETTER_AUTH_SECRET=
# The public origin the admin site is served from (https in production, no trailing slash).
# Development: http://localhost:5173 (the default when empty).
# It is also the only origin allowed to call the sign-in API.
BETTER_AUTH_URL=
# The secret sign-in page. One segment, 8-64 letters/numbers/-/_, hard to guess, e.g. /bb-portal-7k2q9x.
# Never link to it. /login, /signin, /admin/login, ... always answer 404.
LOGIN_PATH=/bb-portal-change-me
# Who receives security alerts (comma-separated).
ALERT_EMAILS=josue.mapagdalita@bytebuntech.com,arvi.genio@bytebuntech.com
# Optional: every security alert is also POSTed here as JSON (e.g. an n8n webhook).
SECURITY_ALERT_WEBHOOK_URL=

# Outgoing email (sign-in codes and alerts). In development, leave SMTP_HOST empty and the
# emails are printed in the api log instead.
SMTP_HOST=
# 587 = STARTTLS (required), 465 = TLS from the start.
SMTP_PORT=587
# Must be the admin@bytebuntech.com mailbox, or an account allowed to send as it.
SMTP_USER=admin@bytebuntech.com
SMTP_PASS=
MAIL_FROM="Byte Bun Admin <admin@bytebuntech.com>"

# ---- Lead emails (booking confirmation, reminder, reschedule/cancel) ----
# Sender for emails to leads (SMTP_USER must be allowed to send as it), and where their replies go
# (empty = the sender address).
LEADS_MAIL_FROM="Byte Bun Tech <admin@bytebuntech.com>"
LEADS_REPLY_TO=
# Optional: a fixed video-call link (Zoom, Google Meet, ...) for every call. Shown as a
# "Join the video call" button and used as the calendar event's location.
CALL_MEETING_URL=

# ---- Admin Prospecting page (find businesses by industry + location) ----
# Where businesses come from. Leave PROSPECTS_SOURCE empty to use the first one with a key:
# HERE, then Geoapify, then Google, then free OpenStreetMap (slow, no key).
#   here:     platform.here.com -> sign up (free Base plan) -> Access Manager -> create an app ->
#             API Keys -> create key. Free monthly allowance, then pay per 1,000 searches; a search
#             = 1 geocode + 1 discover. HERE's own business data: phone, website, sometimes email;
#             no ratings or reviews. The key also draws the Prospecting map's tiles.
#   geoapify: myprojects.geoapify.com -> create a project -> copy its API key. Free plan:
#             3,000 credits/day (a search = 1 credit for the location + 1 per 20 businesses).
#             OpenStreetMap data: phone, website, social pages; no ratings or reviews.
#   google:   Google Cloud -> enable "Places API (New)" -> API key. Ratings and reviews; billed.
PROSPECTS_SOURCE=
HERE_API_KEY=
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=
# Most businesses one search returns (5-60 with Google, up to 100 with HERE, up to 200 otherwise).
PROSPECTS_MAX_RESULTS=60
# Open each business's homepage to check it (secure, mobile-ready, online booking, chat, age).
PROSPECTS_WEBSITE_CHECKS=true
# Development/testing only: EVERY email (lead and admin) goes to this inbox instead of its real
# recipients, who are shown in the subject. Ignored in production. Set it whenever SMTP_HOST is
# set locally, so test bookings never email real people.
TESTING_EMAIL_ADDRESS=

# ---- Google Tag Manager (public site only, never the admin app) ----
# Container ID from tagmanager.google.com, e.g. GTM-XXXXXXX. Set up the GA4 tag inside GTM.
# Baked into the site at build time: production only, and changing it needs --build.
# Leave empty to turn it off.
VITE_GTM_ID=
