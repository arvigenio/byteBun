FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && cp package-lock.json node_modules/.lock-stamp

COPY . .
EXPOSE 5173

# Same self-healing install as the backend: reinstall only when package-lock.json changed.
CMD ["sh", "-c", "cmp -s package-lock.json node_modules/.lock-stamp || (echo 'Dependencies changed, installing...' && npm install --no-audit --no-fund && cp package-lock.json node_modules/.lock-stamp); exec npm run dev"]
